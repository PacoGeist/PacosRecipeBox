# Keep line endings consistent between Windows and GitHub (prevents LF/CRLF warnings).
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff2 binary
*.wasm binary
*.jar binary
*.jks binary
*.keystore binary
*.apk binary
*.zip binary
